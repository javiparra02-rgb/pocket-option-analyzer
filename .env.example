# Optional, synchronous visual evidence capture for calibration sessions.
# Leave unset to disable all filesystem evidence persistence.
VISUAL_EVIDENCE_DIRECTORY=logs/calibration/p04b_session_02/evidence

# Optional current-candle identity shadow evidence (disabled by default).
VISUAL_IDENTITY_EVIDENCE_ENABLED=false
# Provisional diagnostic defaults pending calibration.
VISUAL_IDENTITY_EVIDENCE_RING_BUFFER_SIZE=30
VISUAL_IDENTITY_EVIDENCE_PRE_EVENT_TRACE_COUNT=5
VISUAL_IDENTITY_EVIDENCE_INTENSIVE_PNG=false
# Omit to disable periodic checkpoint PNGs.
# VISUAL_IDENTITY_EVIDENCE_CHECKPOINT_INTERVAL_FRAMES=60
